PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/media_department
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3100

# Cloudinary (Photo/Graphic/Thumbnail media asset upload) — deliberately the SAME
# Cloudinary account as protocol_dept_app (explicit user decision, overriding the
# separate-accounts default from when Phase 6 was first planned). Not a re-derivation
# of the sibling-apps-independent rule — a specific, confirmed exception to it.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# Termii (SMS) — same account as protocol_dept_app too, same explicit exception. Used
# for crew assignment notifications and, as of Phase 7, forgot/reset-password OTPs
# (AuthService.forgotPassword()/resetPassword()).
TERMII_API_KEY=replace_this_with_your_termii_api_key
TERMII_BASE_URL=https://v4.api.termii.com
# "Termii"/"generic" work without sender-ID registration approval — swap in a
# custom registered sender ID + "dnd" channel once one is approved.
TERMII_SENDER_ID=Termii
TERMII_CHANNEL=generic
