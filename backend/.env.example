PORT=4100
MONGODB_URI=mongodb://127.0.0.1:27017/media_department
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
FRONTEND_URL=http://localhost:3100

# Cloudinary (Photo/Graphic/Thumbnail media asset upload) — use a separate Cloudinary
# account from protocol_dept_app's, not the same one, per the project's
# keep-sibling-apps-independent rule.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>
